<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>new chat</title>
  </head>
  <body>
    <h3>Write a new chat</h3>
    <form action="/chats" method="POST">
      input from: <input type="text" name="from" /><br />
      input to: <input type="text" name="to" /><br />
      input message: <input type="text" name="message" /><br />
      <button type="submit">send</button>
    </form>
  </body>
</html>
